{
  "xo": {
    "prettier": true
  },
  "bugs": {
    "url": "https://github.com/alexandroit/stackline-vfile-reporter-pretty/issues"
  },
  "main": "index.js",
  "name": "@stackline/vfile-reporter-pretty",
  "type": "module",
  "types": "index.d.ts",
  "author": {
    "url": "https://sindresorhus.com",
    "name": "Sindre Sorhus",
    "email": "sindresorhus@gmail.com"
  },
  "funding": {
    "url": "https://opencollective.com/unified",
    "type": "opencollective"
  },
  "license": "MIT",
  "scripts": {
    "test:upstream": "node --conditions development test.js",
    "test": "npm run test:upstream",
    "build": "node scripts/check-payload.mjs",
    "test:package": "node scripts/test-package.mjs",
    "test:types": "tsc --ignoreConfig --noEmit --module NodeNext --moduleResolution NodeNext --target ES2022 --strict test/stackline-types.mts"
  },
  "homepage": "https://alexandro.net/docs/vanilla/vfile-reporter-pretty/",
  "keywords": [
    "stackline",
    "npm-package",
    "vfile-reporter-pretty",
    "typescript",
    "vfile",
    "vfile-util",
    "vfile-reporter",
    "util",
    "utility",
    "reporter",
    "virtual",
    "file",
    "formatter",
    "lint",
    "eslint",
    "validate",
    "pretty",
    "maintenance-fork"
  ],
  "prettier": {
    "semi": false,
    "useTabs": false,
    "tabWidth": 2,
    "singleQuote": true,
    "trailingComma": "none",
    "bracketSpacing": false
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexandroit/stackline-vfile-reporter-pretty.git"
  },
  "description": "vfile utility to create a pretty report for a file",
  "directories": {},
  "sideEffects": false,
  "contributors": [
    {
      "url": "https://sindresorhus.com",
      "name": "Sindre Sorhus",
      "email": "sindresorhus@gmail.com"
    },
    {
      "url": "https://wooorm.com",
      "name": "Titus Wormer",
      "email": "tituswormer@gmail.com"
    }
  ],
  "dependencies": {
    "vfile": "^5.0.0",
    "vfile-to-eslint": "^3.0.0",
    "eslint-formatter-pretty": "^4.0.0"
  },
  "remarkConfig": {
    "plugins": [
      "preset-wooorm"
    ]
  },
  "typeCoverage": {
    "detail": true,
    "strict": true,
    "atLeast": 100
  },
  "devDependencies": {
    "chalk": "^5.0.0",
    "log-symbols": "^5.0.0",
    "typescript": "7.0.2",
    "@types/node": "24.12.2"
  },
  "version": "1.0.2",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "index.d.ts",
    "index.js",
    "lib/index.d.ts",
    "lib/index.js",
    "license",
    "readme.md",
    "UPSTREAM.md",
    "NOTICE",
    "CHANGELOG.md"
  ]
}
